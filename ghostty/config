# Ghostty 설정 (~/.config/ghostty/config)
# iTerm2 기본 프로필에서 쓰던 값을 옮긴 것이다.
# 전체 옵션: ghostty +show-config --default --docs
# 수정 후 Cmd+Shift+, 로 다시 읽는다.

# --- 폰트 (iTerm2: BlexMonoNFP-BoldItalic 15) ---
font-family = BlexMono Nerd Font Propo
font-style = Bold Italic
font-size = 15

# --- 창 (iTerm2: 100x30, 여백 10/2, 투명도 0.1 + 블러) ---
window-width = 100
window-height = 30
window-padding-x = 10
window-padding-y = 2
background-opacity = 0.9
background-blur = 20
macos-titlebar-style = tabs
unfocused-split-opacity = 0.65

# --- 동작 ---
cursor-style-blink = true
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
# 바이트 단위. iTerm2 의 무제한 스크롤백에 가깝게 넉넉히 둔다.
scrollback-limit = 100000000

# --- 색상 (iTerm2 기본 프로필: 검정 배경 + Tango 팔레트) ---
background = #000000
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #000000
selection-background = #b5d5ff
selection-foreground = #000000
palette = 0=#000000
palette = 1=#cc0000
palette = 2=#4e9a06
palette = 3=#c4a000
palette = 4=#3465a4
palette = 5=#75507b
palette = 6=#06989a
palette = 7=#d3d7cf
palette = 8=#555753
palette = 9=#ef2929
palette = 10=#8ae234
palette = 11=#fce94f
palette = 12=#729fcf
palette = 13=#ad7fa8
palette = 14=#34e2e2
palette = 15=#eeeeec
