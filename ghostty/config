# Ghostty 설정 (~/.config/ghostty/config)
# iTerm2 기본 프로필에서 쓰던 값을 옮긴 것이다.
# 전체 옵션: ghostty +show-config --default --docs
# 수정 후 Cmd+Shift+, 로 다시 읽는다.

# --- 폰트 (iTerm2: BlexMonoNFP-BoldItalic 15) ---
font-family = BlexMono Nerd Font Propo
font-style = Bold Italic
font-size = 15

# --- 창 (iTerm2: 100x30, 여백 10/2, 투명도 0.1 + 블러) ---
window-width = 100
window-height = 30
window-padding-x = 10
window-padding-y = 2
background-opacity = 0.9
background-blur = 20
macos-titlebar-style = tabs
unfocused-split-opacity = 0.65

# --- 동작 ---
cursor-style-blink = true
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
# 바이트 단위. iTerm2 의 무제한 스크롤백에 가깝게 넉넉히 둔다.
scrollback-limit = 100000000

# --- 색상 ---
# starship 프롬프트와 같은 팔레트. 내장 테마 목록: ghostty +list-themes
# 다른 톤: Catppuccin Mocha / Frappe / Latte. 이 줄을 지우면 Ghostty 기본 색이 된다.
theme = Catppuccin Macchiato
