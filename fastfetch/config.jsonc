{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	// 터미널을 열 때마다 실행되므로 네트워크를 타는 모듈(publicip, weather)과
	// 샘플링이 필요한 모듈(cpuusage)은 넣지 않는다.
	"modules": [
		"title",
		"separator",
		"os",
		"host",
		"kernel",
		"shell",
		"terminal",
		"uptime",
		"packages",
		"break",
		"cpu",
		"gpu",
		"memory",
		"disk",
		"battery",
		"localip",
		"break",
		"datetime",
		"break",
		"colors"
	]
}
