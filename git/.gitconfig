# 공통 git 설정. 이름·이메일 등 개인 정보는 ~/.gitconfig.local 에 둔다.
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[core]
	autocrlf = input
	quotepath = false
[diff]
	colorMoved = default
# delta 가 설치돼 있으면 zsh 가 GIT_PAGER=delta 로 연결한다 (없으면 이 섹션은 무시됨)
[delta]
	navigate = true
	line-numbers = true
[include]
	path = ~/.gitconfig.local
